amends "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Config.pkl"
import "package://github.com/jdx/hk/releases/download/v2.4.0/hk@2.4.0#/Builtins.pkl"

// Fast checks: run on staged files at commit time and on the whole
// repository in CI with `hk check --all`.
steps {
    ["go-fmt"] = Builtins.go_fmt
    ["golangci-lint"] = Builtins.golangci_lint
    ["gomod-tidy"] = Builtins.gomod_tidy
    // shellcheck is a separate step where available; actionlint's built-in
    // shellcheck integration is disabled because it resolves the executable
    // through mise shims, which are not reliable in hook environments.
    ["actionlint"] = (Builtins.actionlint) {
        check = "actionlint -shellcheck= {{ files }}"
    }
    ["pinact"] = Builtins.pinact
    ["shellcheck"] = Builtins.shellcheck
}
